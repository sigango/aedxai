# Copy to cluster/cluster.env and edit. Sourced by cluster/task.sh and cluster/submit.sh.
# Paths may be relative to the repository root.

# Python interpreter inside the environment that has torch, yolox, captum, skimage.
PYTHON=python
# Optional prefix for every command, e.g. a container:
#   RUN_PREFIX="apptainer exec --nv --bind ${PWD} /shared/containers/pytorch_25.11-py3.sif"
#   RUN_PREFIX="srun --container-image=nvcr.io#nvidia/pytorch:25.11-py3 --container-mounts=${PWD}:${PWD}"
RUN_PREFIX=""

# Scheduler backend for cluster/submit.sh: "slurm" or "local".
BACKEND=slurm
SLURM_PARTITION=gpu
SLURM_ACCOUNT=
SLURM_TIME=24:00:00
SLURM_CPUS=8
SLURM_MEM=48G
SLURM_GRES=gpu:1
# local backend: comma-separated GPU ids and processes per GPU (DGX Spark: 0 and 2-3).
LOCAL_GPUS=0
# One process per GPU: Faster R-CNN already saturates a GB10, so a second process
# only halves the speed of each (measured in the notebook 06 smoke run).
PROCS_PER_GPU=1

# Hugging Face / torch caches (VLM weights ~16 GB in fp16).
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export TORCH_HOME="${TORCH_HOME:-$HOME/.cache/torch}"

# Data.
COCO_IMAGES=data/coco/val2017
COCO_ANN=data/coco/annotations/instances_val2017.json
MANIFEST=manifests/coco_val2017_v2.json
BDD_IMAGES=data/bdd100k/images/100k/val
BDD_LABELS=data/bdd100k/labels/det_20/det_val.json
BDD_ANN=data/bdd100k/annotations_coco80_val.json
BDD_MANIFEST=manifests/bdd100k_val_v2.json

# Optional cap on explained detections per image for every evidence task
# (overrides the config; e.g. 10 keeps the Faster R-CNN budget manageable).
MAX_EXPLAINED="${MAX_EXPLAINED:-}"   # an exported value (e.g. MAX_EXPLAINED=10 cluster/submit.sh ...) wins

# Optional per-split, per-detector image caps (unset/0 = whole manifest split).
# Pre-registered for the scenario-C test run (PREREGISTRATION.md): YOLOX gets the
# whole split (COCO test 2000, BDD100K test 1000), Faster R-CNN the first 500 COCO
# test and the first 150 BDD100K test images. See RESULTS_AND_PLAN.md section B5.
NUM_IMAGES_test_frcnn=500
NUM_IMAGES_dev_frcnn=150
NUM_IMAGES_bdd_frcnn=150
# Images for the legacy v1 comparison runs (first N of the test split).
# Scenario C does not run the legacy, selector, calib or cascade stages.
LEGACY_NUM_IMAGES=1000
# Plan B legacy rows: every v1 row for YOLOX; for Faster R-CNN only the cheap
# baselines and the relabelled selector (its LIME/D-CLOSE baselines alone cost
# ~175 GPU-h on a GB10). Unset a variable to run every row for that detector.
LEGACY_METHODS_yolox="gradcam gcame dclose lime"
LEGACY_VARIANTS_yolox="v1 v1orig"
LEGACY_METHODS_frcnn="gradcam gcame"
LEGACY_VARIANTS_frcnn="v1"
CASCADE_DETECTORS="yolox"

# Shards per array job (one GPU each). Raise for the test split.
SHARDS_PILOT=4
SHARDS_CALIB=8
SHARDS_TEST=16
SHARDS_XDOMAIN=16
SHARDS_VLM=4
SHARDS_LEGACY=4
